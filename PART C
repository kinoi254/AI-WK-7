import pandas as pd
from aif360.algorithms.preprocessing import Reweighing
from aif360.datasets import BinaryLabelDataset
from aif360.metrics import BinaryLabelDatasetMetric
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
import matplotlib.pyplot as plt

Load COMPAS dataset
compas_df = pd.read_csv('compas-scores-two-years.csv')

Preprocess data
compas_df = compas_df[['age', 'sex', 'race', 'juv_fel_count', 'juv_misd_count', 'juv_other_count', 'priors_count', 'c_charge_degree', 'score_text']]

Convert score_text to binary label
compas_df['score_text'] = compas_df['score_text'].map({'Low': 0, 'Medium': 1, 'High': 1})

Create BinaryLabelDataset object
dataset = BinaryLabelDataset(compas_df, protected_attribute_names=['race'], label_names=['score_text'])

Calculate metrics
metric = BinaryLabelDatasetMetric(dataset)
print("Disparate Impact:", metric.disparate_impact())
print("Statistical Parity Difference:", metric.statistical_parity_difference())

Reweighing algorithm to mitigate bias
rw = Reweighing(unprivileged_groups=[{'race': 0}], privileged_groups=[{'race': 1}])
transformed_dataset = rw.fit_transform(dataset)

Calculate metrics after reweighing
metric_after_rw = BinaryLabelDatasetMetric(transformed_dataset)
print("Disparate Impact after reweighing:", metric_after_rw.disparate_impact())
print("Statistical Parity Difference after reweighing:", metric_after_rw.statistical_parity_difference())

Visualize disparity in false positive rates
privileged_group = compas_df[compas_df['race'] == 1]
unprivileged_group = compas_df[compas_df['race'] == 0]

privileged_fp = privileged_group[(privileged_group['score_text'] == 1) & (privileged_group['score_text'] != privileged_group['label'])]
unprivileged_fp = unprivileged_group[(unprivileged_group['score_text'] == 1) & (unprivileged_group['score_text'] != unprivileged_group['label'])]

print("False Positive Rate (Privileged Group):", len(privileged_fp) / len(privileged_group))
print("False Positive Rate (Unprivileged Group):", len(unprivileged_fp) / len(unprivileged_group))

Plot disparity in false positive rates
plt.bar(['Privileged', 'Unprivileged'], [len(privileged_fp) / len(privileged_group), len(unprivileged_fp) / len(unprivileged_group)])
plt.xlabel('Group')
plt.ylabel('False Positive Rate')
plt.title('Disparity in False Positive Rates')
plt.show()
